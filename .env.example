# Optional: Set in Netlify Site Settings -> Environment Variables (NEVER prefix GEMINI_API_KEY with VITE_)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_DAILY_REQUEST_LIMIT=50
GEMINI_AI_ENABLED=true

# Optional: Custom remote URLs if hosting backends separately from Netlify
# VITE_AI_API_BASE=
# VITE_SANDBOX_URL=http://localhost:8787/api/execute
